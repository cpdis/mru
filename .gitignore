# The preprocessed run data lives in site/public/data and is committed so
# the site can build without the raw GPX files in CI. Regenerate locally
# with `pnpm preprocess` after editing GPX inputs.

# Personal training exports — Strava bulk archives include private DMs,
# logins, contacts, support tickets, and device identifiers. TrainingPeaks
# CSVs include athlete/coach comments. Keep all of this local-only; the
# public site only ships the aggregated training.json.
training/strava/
training/trainingpeaks/

# Remotion render outputs. Re-generate with `pnpm render` from video/.
video/out/

# Backing music — kept local only. Add the MP3/M4A to video/public/ to
# render with audio; Instagram users add it via the audio picker instead.
video/public/*.mp3
video/public/*.m4a
video/public/*.wav
.vercel
.env*.local
github-takedown.txt
twitter-thread.md
