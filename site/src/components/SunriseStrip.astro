---
import SunCalc from "suncalc";
import { RUNS, YEARS } from "../lib/data";
import { START_LAT, START_LON } from "../data/course";

// For each year compute sunrise at the start coordinates on race day, then
// find the km bin whose wallclock is closest to that moment. That tells us
// where on the course we were when the sun came up.
const moments = YEARS.map((y) => {
  const run = RUNS[y];
  const start = new Date(run.startIso);
  const sunrise = SunCalc.getTimes(start, START_LAT, START_LON).sunrise;
  // Closest km bin by wallclock distance.
  let nearest = run.km[0];
  let best = Infinity;
  for (const b of run.km) {
    const d = Math.abs(new Date(b.wallclock_iso).getTime() - sunrise.getTime());
    if (d < best) {
      best = d;
      nearest = b;
    }
  }
  // Human‑readable AWST sunrise time (UTC+8).
  const awst = new Date(sunrise.getTime() + 8 * 60 * 60 * 1000);
  const hh = String(awst.getUTCHours()).padStart(2, "0");
  const mm = String(awst.getUTCMinutes()).padStart(2, "0");
  return {
    year: y,
    sunriseLocal: `${hh}:${mm}`,
    km: nearest.km,
    pct: (nearest.km / 80) * 100,
  };
});

// Race start in AWST is 06:15. Frame the strip from 05:30 to 08:00 to give
// the sunrise moment some context.
const stripStartH = 5 + 30 / 60;
const stripEndH = 8;
const span = stripEndH - stripStartH;

function pctFromHHMM(hhmm: string): number {
  const [h, m] = hhmm.split(":").map(Number);
  const t = h + m / 60;
  return ((t - stripStartH) / span) * 100;
}
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Sunrise · 06:15 start in the dark</p>
    <h2 class="h2">The first hour is run by headtorch.</h2>
    <p class="prose muted">
      The race starts at 6:15 a.m., before the sun is up. By the time the sky
      lights up, you are already deep in the karri. Each year shows where you
      were on the course at official sunrise.
    </p>

    <div class="strip-wrap">
      <div class="sky">
        <span class="t-start num">05:30</span>
        <span class="t-mid num" style={`left: ${pctFromHHMM("06:15")}%;`}>
          06:15<br/><i>start</i>
        </span>
        <span class="t-end num">08:00</span>
      </div>

      {moments.map((m) => (
        <div class="row" style={`--c: var(--c-${m.year});`}>
          <div class="row-label">
            <span class="num">{m.year}</span>
            <span class="muted num">sunrise {m.sunriseLocal}</span>
          </div>
          <div class="track">
            <div class="ribbon"></div>
            <div class="sun" style={`left: ${pctFromHHMM(m.sunriseLocal)}%;`} aria-hidden>
              <span class="sun-circle"></span>
              <span class="sun-label num">at km {m.km}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .strip-wrap {
    margin-top: 2.5rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
  }
  .sky {
    position: relative;
    height: 1.4rem;
    margin: 0 0 0.8rem 8.5rem;
    color: var(--ink-muted);
    font-size: 0.7rem;
    font-family: var(--mono);
  }
  .t-start { position: absolute; left: 0; }
  .t-end   { position: absolute; right: 0; }
  .t-mid   {
    position: absolute;
    transform: translateX(-50%);
    text-align: center;
    line-height: 1.2;
  }
  .t-mid i { font-style: italic; font-family: var(--serif); }

  .row {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0;
    align-items: center;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }
  .row-label {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--c);
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .row-label .muted { color: var(--ink-muted); font-weight: 500; letter-spacing: 0.05em; }

  .track {
    position: relative;
    height: 2.2rem;
  }
  .ribbon {
    position: absolute;
    inset: 0.55rem 0;
    background: linear-gradient(
      to right,
      #1a2233 0%,
      #2c2c44 25%,
      #6a4c52 60%,
      #d8a86a 80%,
      #f5dca0 95%,
      #f5f1e8 100%
    );
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .sun {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
  }
  .sun-circle {
    width: 14px;
    height: 14px;
    background: #f5dca0;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--paper), 0 0 12px 4px rgba(245, 220, 160, 0.7);
    margin-top: 0.35rem;
  }
  .sun-label {
    margin-top: 0.25rem;
    font-size: 0.7rem;
    color: var(--c);
    font-weight: 600;
    background: var(--paper);
    padding: 0 4px;
  }

  @media (max-width: 640px) {
    .sky { margin-left: 5rem; }
    .row { grid-template-columns: 5rem 1fr; }
    .row-label { font-size: 0.7rem; }
  }
</style>
