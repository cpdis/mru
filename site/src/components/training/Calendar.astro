---
import { TRAINING, TRAINING_YEARS } from "../../lib/training";

// GitHub-style calendar heatmap, one strip per year. Each cell is a day,
// shaded by daily TSS. Days with no recorded TSS but at least one Strava
// activity get a baseline tint so "I trained but no TP record" still
// reads as a training day.

type Cell = {
  date: string;
  tss: number;
  hasActivity: boolean;
  isRace: boolean;
};

function cellsFor(year: number): Cell[] {
  const b = TRAINING[year];
  return b.days.map((d) => ({
    date: d.date,
    tss: d.tss,
    hasActivity: d.runs + d.rides + d.other > 0,
    isRace: d.date === b.raceDay,
  }));
}

// Pad each year's cells so it starts on the right weekday column. We use
// columns = weeks, rows = days of week (0..6, Mon=0). Stride down each
// column then advance.
const DOW_OFFSET = (year: number): number => {
  // Weekday of Jan 1 (UTC), 0=Sun..6=Sat. Convert to Mon=0 layout.
  const d = new Date(`${year}-01-01T00:00:00Z`).getUTCDay();
  return (d + 6) % 7;
};

// Flat scale: TSS 0..200+ → opacity 0..1. Cap above 200 so nuking days
// don't blow out the rest.
function tssOpacity(tss: number): number {
  if (tss <= 0) return 0;
  return Math.min(1, 0.18 + (Math.min(tss, 200) / 200) * 0.82);
}

const cellsByYear = TRAINING_YEARS.map((y) => ({
  year: y,
  offset: DOW_OFFSET(y),
  cells: cellsFor(y),
}));

const COLUMNS = Math.ceil((Math.max(...TRAINING_YEARS.map((y) => TRAINING[y].blockDays)) + 6) / 7);

const MONTH_TICKS = [
  { label: "Jan", day: 0 },
  { label: "Feb", day: 31 },
  { label: "Mar", day: 60 },
  { label: "Apr", day: 90 },
  { label: "May", day: 120 },
];
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Calendar · daily TSS</p>
    <h2 class="h2">Day after day, week after week.</h2>
    <p class="prose muted">
      One cell per day from Jan 1 through race day, shaded by daily training
      stress. Empty cells were rest. The race day itself is outlined in
      forest green. The visible difference between rows is mostly the rare
      days off in 2025 and 2026 vs 2024.
    </p>

    <div class="cal-wrap">
      {cellsByYear.map(({ year, offset, cells }) => (
        <div class="cal-row" style={`--c: var(--c-${year});`}>
          <div class="cal-lab">
            <span class="num">{year}</span>
          </div>
          <div class="cal-grid" style={`grid-template-columns: repeat(${COLUMNS}, 1fr);`}>
            {Array.from({ length: offset }, (_, i) => (
              <div class="day pad" style={`grid-column: ${Math.floor(i / 7) + 1}; grid-row: ${(i % 7) + 1};`}></div>
            ))}
            {cells.map((c, i) => {
              const idx = i + offset;
              const col = Math.floor(idx / 7) + 1;
              const row = (idx % 7) + 1;
              const op = tssOpacity(c.tss);
              const cls = c.isRace
                ? "day race"
                : c.tss > 0
                  ? "day filled"
                  : c.hasActivity
                    ? "day light"
                    : "day empty";
              return (
                <div
                  class={cls}
                  style={`grid-column: ${col}; grid-row: ${row}; --op: ${op};`}
                  title={`${c.date} · ${c.tss > 0 ? `TSS ${Math.round(c.tss)}` : c.hasActivity ? "activity (no TP)" : "rest"}`}
                />
              );
            })}
          </div>
        </div>
      ))}
      <div class="cal-axis">
        <div class="cal-lab"></div>
        <div class="ticks">
          {MONTH_TICKS.map((m) => (
            <span class="tick" style={`--at: ${(m.day / 140) * 100}%;`}>
              {m.label}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cal-wrap { margin-top: 2.5rem; }
  .cal-row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.45rem;
  }
  .cal-lab {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    color: var(--c, var(--ink-muted));
    font-weight: 600;
  }
  .cal-grid {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    grid-auto-flow: column;
    gap: 2px;
  }
  .day {
    aspect-ratio: 1;
    border-radius: 1px;
    background: var(--paper-deep);
    min-width: 6px;
  }
  .day.empty { background: var(--paper-deep); opacity: 0.5; }
  .day.light { background: var(--c); opacity: 0.18; }
  .day.filled { background: var(--c); opacity: var(--op); }
  .day.race {
    background: var(--c);
    opacity: 1;
    box-shadow: 0 0 0 1.5px var(--ink), 0 0 0 3px var(--paper);
  }
  .day.pad { background: transparent; }

  .cal-axis {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .ticks { position: relative; height: 1.1rem; }
  .tick {
    position: absolute;
    left: var(--at);
    transform: translateX(-50%);
    font-size: 0.7rem;
    font-family: var(--mono);
    color: var(--ink-muted);
    border-left: 1px solid var(--rule);
    padding-left: 4px;
  }

  @media (max-width: 640px) {
    .cal-row, .cal-axis { grid-template-columns: 2.5rem 1fr; }
    .day { min-width: 4px; }
  }
</style>
