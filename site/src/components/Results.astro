---
import { YEARS } from "../lib/data";

// Official chip-timed results from BlueChip Results, one row per year.
// These are immutable historical facts and live as a hand-typed const so
// they're trivially auditable. Source URLs:
//   2024 https://bluechipresults.com.au/myresults.aspx?uid=11-1736-1-731899
//   2025 https://bluechipresults.com.au/myresults.aspx?uid=11-1845-1-975
//   2026 https://www.bluechipresults.com.au/myresults.aspx?uid=11-1968-1-9
const RESULTS = {
  2024: {
    chipTime: "8:33:55",
    overall: { place: 11, of: 285 },
    category: { place: 6, of: 81 },
    gender: { place: 8, of: 188 },
    bib: 73,
  },
  2025: {
    chipTime: "8:04:24",
    overall: { place: 11, of: 349 },
    category: { place: 8, of: 116 },
    gender: { place: 8, of: 255 },
    bib: 130,
  },
  2026: {
    chipTime: "7:28:39",
    overall: { place: 4, of: 333 },
    category: { place: 4, of: 112 },
    gender: { place: 4, of: 228 },
    bib: 7,
  },
} as const;

const sourceUrl: Record<number, string> = {
  2024: "https://bluechipresults.com.au/myresults.aspx?uid=11-1736-1-731899",
  2025: "https://bluechipresults.com.au/myresults.aspx?uid=11-1845-1-975",
  2026: "https://www.bluechipresults.com.au/myresults.aspx?uid=11-1968-1-9",
};
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Official results · BlueChip</p>
    <h2 class="h2">Eleventh, eleventh, fourth.</h2>
    <p class="prose muted">
      Same effort each year, faster splits each year, deeper into the
      leaderboard each year. Category is M20–39; field is the solo ultra
      starters who finished within the cutoff.
    </p>

    <div class="grid">
      {YEARS.map((y) => {
        const r = RESULTS[y];
        return (
          <a
            class="card"
            style={`--c: var(--c-${y});`}
            href={sourceUrl[y]}
            target="_blank"
            rel="noopener"
          >
            <div class="head">
              <span class="num year">{y}</span>
              <span class="num bib">bib&nbsp;<span class="b-num">{r.bib}</span></span>
            </div>
            <div class="time num">{r.chipTime}</div>

            <dl class="stats">
              <div>
                <dt>Overall</dt>
                <dd class="num">
                  <span class="big">{r.overall.place}</span>
                  <span class="of">/ {r.overall.of}</span>
                </dd>
              </div>
              <div>
                <dt>Men 20–39</dt>
                <dd class="num">
                  <span class="big">{r.category.place}</span>
                  <span class="of">/ {r.category.of}</span>
                </dd>
              </div>
              <div>
                <dt>Male</dt>
                <dd class="num">
                  <span class="big">{r.gender.place}</span>
                  <span class="of">/ {r.gender.of}</span>
                </dd>
              </div>
            </dl>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.5rem 1.5rem 1.75rem;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--c);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    color: inherit;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1), border-color 200ms;
  }
  .card:hover { transform: translateY(-2px); border-color: var(--c); }
  @media (prefers-color-scheme: dark) {
    .card { background: var(--paper-deep); }
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .year {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    color: var(--c);
    font-weight: 600;
  }
  .bib {
    font-size: 0.7rem;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }
  .b-num { font-weight: 600; }

  .time {
    font-family: var(--mono);
    font-feature-settings: "tnum" 1;
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    font-weight: 500;
    color: var(--c);
    line-height: 1;
  }

  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
  }
  .stats div {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.5rem;
  }
  .stats dt {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .stats dd { margin: 0; display: inline-flex; align-items: baseline; gap: 0.4rem; }
  .big {
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--ink);
  }
  .of { font-size: 0.85rem; color: var(--ink-muted); }

  /* The latest year's "place" reads as the highlight. */
  .card:last-child .big { color: var(--c); }

  @media (max-width: 880px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 540px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
