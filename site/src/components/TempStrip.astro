---
import { RUNS, YEARS } from "../lib/data";

const allTemps = YEARS.flatMap((y) => RUNS[y].km.map((b) => b.temp ?? null).filter((v): v is number => v !== null));
const tMin = Math.floor(Math.min(...allTemps));
const tMax = Math.ceil(Math.max(...allTemps));

function cellStyle(t: number): string {
  const k = Math.max(0, Math.min(1, (t - tMin) / (tMax - tMin)));
  if (k <= 0.5) {
    const a = (k / 0.5) * 100;
    return `background: color-mix(in oklab, rgb(var(--temp-cool)) ${100 - a}%, rgb(var(--temp-mid)) ${a}%);`;
  }
  const a = ((k - 0.5) / 0.5) * 100;
  return `background: color-mix(in oklab, rgb(var(--temp-mid)) ${100 - a}%, rgb(var(--temp-hot)) ${a}%);`;
}
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Ambient temperature</p>
    <h2 class="h2">Cool sand to warm vines.</h2>
    <p class="prose muted">
      Garmin's ambient sensor through the day. The autumn coast is forgiving —
      mid‑teens at the start, low‑twenties at the finish — but the relative
      heat builds on every leg.
    </p>

    <div class="strip">
      {YEARS.map((y) => {
        const r = RUNS[y];
        return (
          <div class="row" style={`--c: var(--c-${y});`}>
            <div class="lab">
              <span class="num">{y}</span>
            </div>
            <div class="cells">
              {Array.from({ length: 80 }, (_, i) => i + 1).map((k) => {
                const bin = r.km.find((b) => b.km === k);
                const t = bin?.temp ?? null;
                return (
                  <div
                    class="cell"
                    style={t === null ? "background: var(--paper-deep);" : cellStyle(t)}
                    title={t === null ? `km ${k}` : `km ${k} · ${t.toFixed(1)}°C`}
                  />
                );
              })}
            </div>
          </div>
        );
      })}
      <div class="legend num">
        <span>{tMin}°C</span>
        <div class="grad"></div>
        <span>{tMax}°C</span>
      </div>
    </div>
  </div>
</section>

<style>
  .strip { margin-top: 2.5rem; }
  .row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .lab {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    color: var(--c);
    font-weight: 600;
  }
  .cells {
    display: grid;
    grid-template-columns: repeat(80, 1fr);
    gap: 1px;
    height: 1.4rem;
  }
  .cell { height: 100%; border-radius: 1px; }
  .legend {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    color: var(--ink-muted);
  }
  .grad {
    flex: 0 0 10rem;
    height: 0.35rem;
    background: linear-gradient(to right,
      rgb(var(--temp-cool)),
      rgb(var(--temp-mid)),
      rgb(var(--temp-hot)));
    border-radius: 1px;
  }
  @media (max-width: 640px) {
    .row { grid-template-columns: 2.5rem 1fr; }
  }
</style>
