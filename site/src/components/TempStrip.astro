---
import { RUNS, YEARS } from "../lib/data";

const allTemps = YEARS.flatMap((y) => RUNS[y].km.map((b) => b.temp ?? null).filter((v): v is number => v !== null));
const tMin = Math.floor(Math.min(...allTemps));
const tMax = Math.ceil(Math.max(...allTemps));

function color(t: number): string {
  // cool blue → warm ochre
  const k = Math.max(0, Math.min(1, (t - tMin) / (tMax - tMin)));
  const stops: [number, [number, number, number]][] = [
    [0.0, [88, 122, 142]], // cool
    [0.5, [197, 168, 90]], // warm sand
    [1.0, [165, 90, 50]], // hot ochre
  ];
  for (let i = 0; i < stops.length - 1; i++) {
    const [t0, c0] = stops[i];
    const [t1, c1] = stops[i + 1];
    if (k <= t1) {
      const a = (k - t0) / (t1 - t0);
      const r = Math.round(c0[0] + (c1[0] - c0[0]) * a);
      const g = Math.round(c0[1] + (c1[1] - c0[1]) * a);
      const b = Math.round(c0[2] + (c1[2] - c0[2]) * a);
      return `rgb(${r} ${g} ${b})`;
    }
  }
  return "rgb(165 90 50)";
}
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Ambient temperature</p>
    <h2 class="h2">Cool sand to warm vines.</h2>
    <p class="prose muted">
      Garmin's ambient sensor through the day. The autumn coast is forgiving —
      mid‑teens at the start, low‑twenties at the finish — but the relative
      heat builds on every leg.
    </p>

    <div class="strip">
      {YEARS.map((y) => {
        const r = RUNS[y];
        return (
          <div class="row" style={`--c: var(--c-${y});`}>
            <div class="lab">
              <span class="num">{y}</span>
            </div>
            <div class="cells">
              {Array.from({ length: 80 }, (_, i) => i + 1).map((k) => {
                const bin = r.km.find((b) => b.km === k);
                const t = bin?.temp ?? null;
                return (
                  <div
                    class="cell"
                    style={t === null ? "background: var(--paper-deep);" : `background: ${color(t)};`}
                    title={t === null ? `km ${k}` : `km ${k} · ${t.toFixed(1)}°C`}
                  />
                );
              })}
            </div>
          </div>
        );
      })}
      <div class="legend num">
        <span>{tMin}°C</span>
        <div class="grad"></div>
        <span>{tMax}°C</span>
      </div>
    </div>
  </div>
</section>

<style>
  .strip { margin-top: 2.5rem; }
  .row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .lab {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    color: var(--c);
    font-weight: 600;
  }
  .cells {
    display: grid;
    grid-template-columns: repeat(80, 1fr);
    gap: 1px;
    height: 1.4rem;
  }
  .cell { height: 100%; border-radius: 1px; }
  .legend {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    color: var(--ink-muted);
  }
  .grad {
    flex: 0 0 10rem;
    height: 0.35rem;
    background: linear-gradient(to right, rgb(88 122 142), rgb(197 168 90), rgb(165 90 50));
    border-radius: 1px;
  }
  @media (max-width: 640px) {
    .row { grid-template-columns: 2.5rem 1fr; }
  }
</style>
