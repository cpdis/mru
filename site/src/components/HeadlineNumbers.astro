---
import { RUNS, YEARS } from "../lib/data";
import { fmtElapsedLong, fmtPace, fmtSignedMin } from "../lib/format";

const rows = [
  {
    label: "Finish time",
    values: YEARS.map((y) => fmtElapsedLong(RUNS[y].elapsedSec)),
    diffs: YEARS.map((y, i) =>
      i === 0 ? null : fmtSignedMin(RUNS[y].elapsedSec - RUNS[YEARS[i - 1]].elapsedSec)
    ),
  },
  {
    label: "Average pace",
    values: YEARS.map((y) => fmtPace(RUNS[y].avgPaceSecPerKm) + " /km"),
    diffs: YEARS.map((y, i) =>
      i === 0
        ? null
        : fmtSignedMin(RUNS[y].avgPaceSecPerKm - RUNS[YEARS[i - 1]].avgPaceSecPerKm)
    ),
  },
  {
    label: "Average HR",
    values: YEARS.map((y) => `${RUNS[y].avgHr} bpm`),
    diffs: YEARS.map((y, i) =>
      i === 0
        ? null
        : (RUNS[y].avgHr ?? 0) - (RUNS[YEARS[i - 1]].avgHr ?? 0) === 0
          ? "0"
          : `${(RUNS[y].avgHr ?? 0) - (RUNS[YEARS[i - 1]].avgHr ?? 0)}`
    ),
  },
  {
    label: "Max HR",
    values: YEARS.map((y) => `${RUNS[y].maxHr} bpm`),
    diffs: YEARS.map(() => null),
  },
  {
    label: "Elevation gain",
    values: YEARS.map((y) => `${RUNS[y].totalGainM.toLocaleString()} m`),
    diffs: YEARS.map(() => null),
  },
  {
    label: "Distance",
    values: YEARS.map((y) => `${(RUNS[y].totalDistanceM / 1000).toFixed(2)} km`),
    diffs: YEARS.map(() => null),
  },
];
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">By the numbers</p>
    <h2 class="h2">Same effort, faster splits.</h2>
    <p class="prose muted">
      Heart rate held the line. Three years of training showed up everywhere
      else.
    </p>

    <div class="table" role="table">
      <div class="thead" role="row">
        <div></div>
        {YEARS.map((y) => (
          <div class="th" style={`--c: var(--c-${y});`} role="columnheader">
            <span class="num">{y}</span>
          </div>
        ))}
      </div>

      {rows.map((r) => (
        <div class="tr" role="row">
          <div class="th-row" role="rowheader">{r.label}</div>
          {r.values.map((v, i) => (
            <div class="td" style={`--c: var(--c-${YEARS[i]});`} role="cell">
              <span class="v num">{v}</span>
              {r.diffs[i] && <span class="d num">{r.diffs[i]}</span>}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .table {
    margin-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .thead, .tr {
    display: grid;
    grid-template-columns: minmax(8rem, 1.4fr) repeat(3, 1fr);
    gap: clamp(0.5rem, 2vw, 1.5rem);
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .thead {
    border-bottom-color: var(--ink);
    padding-bottom: 0.6rem;
  }
  .th {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c);
    font-weight: 600;
  }
  .th-row {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.1rem;
    color: var(--ink-muted);
  }
  .td {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .v {
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    font-weight: 500;
    color: var(--ink);
  }
  .td:nth-child(4) .v {
    /* the latest year stands out */
    color: var(--c);
  }
  .d {
    font-size: 0.78rem;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }
  @media (max-width: 640px) {
    .thead, .tr {
      grid-template-columns: minmax(6rem, 1fr) repeat(3, 1fr);
      font-size: 0.95rem;
    }
    .th-row { font-size: 0.95rem; }
    .v { font-size: 1rem; }
  }
</style>
