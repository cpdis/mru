---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Hero from "../components/Hero.astro";
import HeadlineNumbers from "../components/HeadlineNumbers.astro";
import CourseMapSection from "../components/CourseMapSection.astro";
import LegSplits from "../components/LegSplits.astro";
import DiffStrip from "../components/DiffStrip.astro";
import PaceHeatmap from "../components/PaceHeatmap.astro";
import HrSection from "../components/HrSection.astro";
import TempStrip from "../components/TempStrip.astro";
import ElevationSection from "../components/ElevationSection.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F5F1E8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Three years of the Margaret River Ultra · Colin Dismuke</title>
    <meta
      name="description"
      content="A look at three runs of the 80‑kilometre Margaret River Ultra Marathon, kilometre by kilometre, heart beat by heart beat."
    />

    <!-- Open Graph share preview. The PNG is generated by
         `pnpm og` from the GPS data + run summary. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mru.cpd.dev/" />
    <meta property="og:site_name" content="mru.cpd.dev" />
    <meta property="og:title" content="Three years on the Cape to Cape" />
    <meta
      property="og:description"
      content="Same course. Same heart rate. Sixty‑five minutes faster. Three runs of the 80 km Margaret River Ultra."
    />
    <meta property="og:image" content="https://mru.cpd.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Map of the 80 km Margaret River Ultra course with finish times of 8:34, 8:04, and 7:29 across 2024, 2025, and 2026." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Three years on the Cape to Cape" />
    <meta
      name="twitter:description"
      content="Same course. Same heart rate. Sixty‑five minutes faster."
    />
    <meta name="twitter:image" content="https://mru.cpd.dev/og.png" />
  </head>
  <body>
    <Hero />
    <HeadlineNumbers />
    <CourseMapSection />
    <LegSplits />
    <DiffStrip />
    <PaceHeatmap />
    <HrSection />
    <TempStrip />
    <ElevationSection />
    <Footer />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
